<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- App content is drawn entirely by Jetpack Compose; this is the pre-Compose
         splash/window background only. -->
    <style name="Theme.Ascend" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/system_bg</item>
        <item name="android:statusBarColor">@color/system_bg</item>
        <item name="android:navigationBarColor">@color/system_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
