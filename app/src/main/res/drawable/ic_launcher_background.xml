<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: a radial field so the mark reads as lit from within
  rather than sitting on flat black, a tighter glow directly behind the chevrons
  for depth, and two faint diagonal streaks for "System interface" texture.
  Corners stay near-black since launchers mask them at varying radii.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54" android:centerY="44" android:gradientRadius="66"
                android:type="radial">
                <item android:offset="0.0" android:color="#FF1B2647" />
                <item android:offset="0.45" android:color="#FF111633" />
                <item android:offset="1.0" android:color="#FF06070C" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M-10,84 L44,20 L52,20 L-2,84 Z"
        android:fillColor="#FF4C8DFF"
        android:fillAlpha="0.05" />
    <path
        android:pathData="M64,20 L70,20 L16,84 L10,84 Z"
        android:fillColor="#FF8B5CF6"
        android:fillAlpha="0.05" />

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54" android:centerY="52" android:gradientRadius="30"
                android:type="radial">
                <item android:offset="0.0" android:color="#4D4C8DFF" />
                <item android:offset="1.0" android:color="#004C8DFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
