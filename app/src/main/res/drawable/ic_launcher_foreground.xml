<?xml version="1.0" encoding="utf-8"?>
<!--
  Ascend mark: a bold chevron pair rising, in the app's blue -> violet accent
  pair. Deliberately frameless — an earlier version wrapped this in the System
  window's cut-corner frame, which read fine at full size but collapsed into
  visual mush at launcher scale. One strong silhouette survives the shrink.

  All geometry stays inside the adaptive-icon safe zone: a 72dp circle centred
  in the 108dp viewport (max radius ~36 from 54,54), so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Leading chevron. -->
    <path android:pathData="M54,30 L78,58 L66,58 L54,44 L42,58 L30,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30" android:startY="30"
                android:endX="78" android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6FA8FF" />
                <item android:offset="1.0" android:color="#FF9B6BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Trailing chevron, dimmer, so the pair reads as upward motion. -->
    <path
        android:pathData="M54,60 L70,79 L61,79 L54,71 L47,79 L38,79 Z"
        android:fillAlpha="0.72">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38" android:startY="60"
                android:endX="70" android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF4C8DFF" />
                <item android:offset="1.0" android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
